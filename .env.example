# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─── Supabase (§5.2 persistent cloud database) ───────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
# SUPABASE_URL  : your project URL  e.g. https://xyzxyzxyz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY : service_role secret key (server-side only, never expose to browser)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
